FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend
WORKDIR /app
COPY backend/pyproject.toml /app/backend/pyproject.toml
RUN python -c 'import subprocess,tomllib; d=tomllib.load(open("backend/pyproject.toml","rb")); subprocess.check_call(["python","-m","pip","install","--no-cache-dir",*d["project"]["dependencies"]])'
RUN groupadd --gid 10001 openguard && useradd --uid 10001 --gid 10001 --no-create-home openguard \
    && install -d -m 0700 -o 10001 -g 10001 /var/lib/openguard
COPY backend/app /app/backend/app
COPY rules /app/rules
COPY LICENSE /app/
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.api.main:create_default_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
