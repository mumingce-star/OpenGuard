          "title": "Previous Result Id"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "data_scope": {
          "enum": [
            "OWNER",
            "TEST_ONLY"
          ],
          "title": "Data Scope",
          "type": "string"
        },
        "computation": {
          "const": "DETERMINISTIC_P2B",
          "default": "DETERMINISTIC_P2B",
          "title": "Computation",
          "type": "string"
        },
        "publication_status": {
          "const": "succeeded",
          "default": "succeeded",
          "title": "Publication Status",
          "type": "string"
        },
        "formal_effect": {
          "const": "none",
          "default": "none",
          "title": "Formal Effect",
          "type": "string"
        },
        "model_calls": {
          "const": 0,
          "default": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "state": {
          "enum": [
            "candidate",
            "unknown",
            "pending",
            "partial"
          ],
          "title": "State",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "usage": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "enum": [
              "commercial",
              "modified",
              "distributed",
              "network_service",
              "training",
              "redistributed_assets",
              "source_disclosure"
            ]
          },
          "title": "Usage",
          "type": "object"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceResult"
          },
          "title": "Resources",
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "title": "Questions",
          "type": "array"
        },
        "material_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Material Ids",
          "type": "array"
        },
        "answer_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Answer Ids",
          "type": "array"
        },
        "recomputed_resource_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Recomputed Resource Ids",
          "type": "array"
        },
        "reused_resource_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Reused Resource Ids",
          "type": "array"
        },
        "companion_summary_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Companion Summary Id",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "revision",
        "previous_result_id",
        "result_sha256",
        "binding",
        "data_scope",
        "state",
        "created_at",
        "usage",
        "resources",
        "questions",
        "material_ids",
        "answer_ids",
        "recomputed_resource_ids",
        "reused_resource_ids",
        "companion_summary_id"
      ],
      "title": "Result",
      "type": "object"
    },
    "ResultIndex": {
      "additionalProperties": false,
      "properties": {
        "head_result_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Head Result Id"
        },
        "head_revision": {
          "title": "Head Revision",
          "type": "integer"
        },
        "result_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Result Ids",
          "type": "array"
        },
        "has_more": {
          "title": "Has More",
          "type": "boolean"
        }
      },
      "required": [
        "head_result_id",
        "head_revision",
        "result_ids",
        "has_more"
      ],
      "title": "ResultIndex",
      "type": "object"
    },
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "answer_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Answer Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "question_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Question Id",
          "type": "string"
        },
        "question_code": {
          "enum": [
            "DELIVERY_SCOPE_FOR_RESOURCES",
            "OBLIGATION_FULFILLMENT_IN_DELIVERY"
          ],
          "title": "Question Code",
          "type": "string"
        },
        "answer_code": {
          "enum": [
            "YES_INCLUDE",
            "NO_EXCLUDE",
            "NOT_DECIDED",
            "FULFILLED",
            "NOT_FULFILLED",
            "NOT_DELIVERED_YET",
            "UNKNOWN"
          ],
          "title": "Answer Code",
          "type": "string"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/Subject"
          },
          "title": "Subjects",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "provenance": {
