{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openguard:p1:notice-draft:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "draft_id": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "$ref": "urn:openguard:p1:common:1.0#/$defs/Binding"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "generator_version": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1
          },
          "resource_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "license_expression_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "obligation_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "namespace": {
                  "enum": [
                    "scan",
                    "assessment"
                  ]
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "obligation_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "namespace",
                "source_id",
                "obligation_id"
              ],
              "additionalProperties": false
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:openguard:p1:common:1.0#/$defs/EvidenceRef"
            }
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "entry_id",
          "resource_ids",
          "license_expression_ids",
          "obligation_refs",
          "evidence_refs",
          "text",
          "missing"
        ],
        "additionalProperties": false
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "$ref": "urn:openguard:p1:common:1.0#/$defs/Provenance"
    }
  },
  "required": [
    "schema_version",
    "draft_id",
    "binding",
    "created_at",
    "generator_version",
    "entries",
    "coverage_gaps",
    "content_hash",
    "provenance"
  ],
  "additionalProperties": false
}
