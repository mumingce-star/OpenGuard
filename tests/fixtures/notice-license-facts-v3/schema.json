{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openguard.local/schemas/notice-license-facts-v3.json",
  "type": "object",
  "required": ["schema_version", "package_status", "generated_at", "producer", "source_inputs", "evidence", "facts", "report_v3_rows"],
  "properties": {
    "schema_version": {"const": "openguard.notice-license-facts/3"},
    "package_status": {"const": "draft_facts_only"},
    "generated_at": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "#/$defs/producer"},
    "source_inputs": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/source"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}},
    "report_v3_rows": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "producer": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false},
    "source": {"type": "object", "required": ["path", "source_file_sha256", "source_revision"], "properties": {"path": {"type": "string"}, "source_file_sha256": {"$ref": "#/$defs/hash"}, "source_revision": {"type": "string"}}, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["evidence_id", "kind", "locator", "source_path", "source_url", "source_revision", "content_scope", "source_file_sha256", "selected_content_sha256", "selected_json_pointer", "captured_at", "producer"], "properties": {"evidence_id": {"type": "string"}, "kind": {"enum": ["repository_file", "provider_snapshot"]}, "locator": {"type": "string"}, "source_path": {"type": "string"}, "source_url": {"type": ["string", "null"]}, "source_revision": {"type": "string"}, "content_scope": {"enum": ["whole_file", "toml_declaration", "xml_dependency", "json_pointer_value"]}, "source_file_sha256": {"$ref": "#/$defs/hash"}, "selected_content_sha256": {"$ref": "#/$defs/hash"}, "selected_json_pointer": {"type": ["string", "null"]}, "captured_at": {"type": "string", "format": "date-time"}, "producer": {"$ref": "#/$defs/producer"}}, "additionalProperties": false},
    "relation": {"type": "object", "required": ["state", "evidence_ids"], "properties": {"state": {"enum": ["text_observed", "provider_declared_unverified", "gap"]}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "gap": {"type": "object", "required": ["code", "severity", "evidence_ids"], "properties": {"code": {"type": "string", "pattern": "^GAP_"}, "severity": {"const": "unknown"}, "evidence_ids": {"type": "array", "maxItems": 0}}, "additionalProperties": false},
    "review": {"type": "object", "required": ["required", "reason"], "properties": {"required": {"const": true}, "reason": {"const": "authorization_and_legal_interpretation_out_of_scope"}}, "additionalProperties": false},
    "fact": {"type": "object", "required": ["fact_id", "subject", "fact_provenance_evidence_ids", "authorization_status", "license_expression_id", "relationships", "gaps", "review"], "properties": {"fact_id": {"type": "string"}, "subject": {"type": "object", "required": ["category", "canonical_id", "display_name", "version", "usage_scope"], "properties": {"category": {"enum": ["root_project", "dependency", "ai_resource"]}, "canonical_id": {"type": "string"}, "display_name": {"type": "string"}, "version": {"type": ["string", "null"]}, "usage_scope": {"type": "string"}}, "additionalProperties": false}, "fact_provenance_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "authorization_status": {"const": "pending"}, "license_expression_id": {"type": "null"}, "relationships": {"type": "object", "required": ["license", "notice", "copyright"], "properties": {"license": {"$ref": "#/$defs/relation"}, "notice": {"$ref": "#/$defs/relation"}, "copyright": {"$ref": "#/$defs/relation"}}, "additionalProperties": false}, "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}, "review": {"$ref": "#/$defs/review"}}, "additionalProperties": false}
  }
}
